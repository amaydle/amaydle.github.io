---
import Layout from '../layouts/Layout.astro';
import { 
  Github, 
  Linkedin, 
  Mail, 
  ExternalLink, 
  Code2, 
  FolderGit2, 
  Layers, 
  Briefcase, 
  GraduationCap, 
  ArrowUpRight,
  Terminal,
  Sparkles
} from 'lucide-astro';

const projects = [
  {
    title: "FilmStrip",
    description: "An aesthetic filter and photo curation application designed to give digital photos the vintage feel of analog film.",
    tags: ["React", "TypeScript", "Tailwind CSS", "Canvas API"],
    github: "https://github.com/amaydle/FilmStrip",
    demo: null,
  },
  {
    title: "CodeRL",
    description: "Final Year Project / Dissertation research exploring reinforcement learning paradigms applied to automated code reasoning and synthesis.",
    tags: ["Python", "PyTorch", "Reinforcement Learning", "NLP"],
    github: "https://github.com/amaydle/CodeRL",
    demo: null,
  },
  {
    title: "Getting Things Done (GTD)",
    description: "A streamlined productivity application implementing David Allen's Getting Things Done methodology for intuitive task capture and workflow management.",
    tags: ["TypeScript", "Full Stack", "Productivity"],
    github: "https://github.com/amaydle/getting-things-done",
    demo: null,
  },
  {
    title: "Cumulus",
    description: "A lightweight cloud utility and micro-service designed for seamless data synchronization and storage experiments.",
    tags: ["Cloud", "API", "Backend"],
    github: "https://github.com/amaydle/Cumulus",
    demo: null,
  },
  {
    title: "Experiments & Snippets",
    description: "A curated repository of small-scale implementations, creative algorithms, UI components, and code experiments.",
    tags: ["Algorithms", "Web Dev", "Prototyping"],
    github: "https://github.com/amaydle/experiments",
    demo: null,
  }
];

const skillCategories = [
  {
    category: "Languages",
    skills: ["TypeScript", "JavaScript", "Python", "HTML5 / CSS3", "SQL"]
  },
  {
    category: "Frontend & UI",
    skills: ["React", "Astro", "Tailwind CSS", "Next.js", "Responsive Design", "Figma"]
  },
  {
    category: "Backend & Cloud",
    skills: ["Node.js", "Express", "RESTful APIs", "Git / GitHub", "Docker"]
  },
  {
    category: "Specialized & Interests",
    skills: ["Machine Learning", "Reinforcement Learning", "System Architecture", "UI/UX"]
  }
];
---

<Layout title="Amaya Kahada Gamage | Portfolio">
  <!-- Navigation Header -->
  <header class="sticky top-0 z-50 backdrop-blur-md bg-neutral-950/80 border-b border-neutral-800/60">
    <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="#" class="font-bold text-lg tracking-tight hover:text-sky-400 transition-colors">
        amaydle<span class="text-sky-400">.</span>
      </a>

      <nav class="hidden md:flex items-center space-x-6 text-sm text-neutral-400 font-medium">
        <a href="#about" class="hover:text-neutral-100 transition-colors">About</a>
        <a href="#projects" class="hover:text-neutral-100 transition-colors">Projects</a>
        <a href="#skills" class="hover:text-neutral-100 transition-colors">Skills</a>
        <a href="#contact" class="hover:text-neutral-100 transition-colors">Contact</a>
      </nav>

      <div class="flex items-center space-x-3 text-neutral-400">
        <a href="https://github.com/amaydle" target="_blank" rel="noreferrer" class="p-2 hover:text-white transition-colors" aria-label="GitHub">
          <Github class="w-5 h-5" />
        </a>
        <a href="https://www.linkedin.com/in/amaydle/" target="_blank" rel="noreferrer" class="p-2 hover:text-white transition-colors" aria-label="LinkedIn">
          <Linkedin class="w-5 h-5" />
        </a>
        <a href="mailto:amayauthsarani@gmail.com" class="p-2 hover:text-white transition-colors" aria-label="Email">
          <Mail class="w-5 h-5" />
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-6 py-12 space-y-24">
    <!-- Hero Section -->
    <section class="pt-8 pb-4 space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-emerald-950/70 text-emerald-400 border border-emerald-800/60">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        Available for opportunities & collaboration
      </div>

      <div class="space-y-4">
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-neutral-100">
          Hi, I'm <span class="bg-gradient-to-r from-sky-400 via-indigo-300 to-purple-400 bg-clip-text text-transparent">Amaya Kahada Gamage</span>
        </h1>
        <p class="text-lg sm:text-xl text-neutral-400 max-w-2xl leading-relaxed">
          Software engineer and developer passionate about crafting robust applications, exploring intelligent systems, and building clean, purposeful user experiences.
        </p>
      </div>

      <div class="flex flex-wrap gap-4 pt-2">
        <a 
          href="#projects" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-sky-500 hover:bg-sky-400 text-neutral-950 font-semibold text-sm transition-all shadow-lg shadow-sky-500/20"
        >
          View Projects
          <ArrowUpRight class="w-4 h-4" />
        </a>
        <a 
          href="mailto:amayauthsarani@gmail.com" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-neutral-900 hover:bg-neutral-800 text-neutral-200 border border-neutral-800 font-medium text-sm transition-colors"
        >
          <Mail class="w-4 h-4" />
          Get in Touch
        </a>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="space-y-6 scroll-mt-20">
      <div class="flex items-center gap-2 text-sky-400 font-mono text-sm">
        <Sparkles class="w-4 h-4" />
        <span>About Me</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4 text-neutral-300 leading-relaxed text-base">
          <p>
            I'm a developer who enjoys solving difficult problems and turning complex ideas into intuitive, elegant digital products. My interests span across full-stack engineering, interactive frontend applications, and machine learning research.
          </p>
          <p>
            When tackling a project, I prioritize clean architecture, performant code, and an intuitive developer and user experience. I enjoy experimenting with new web technologies, automating workflows, and diving into research.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-neutral-900/60 border border-neutral-800/80 space-y-3">
          <h3 class="text-sm font-semibold text-neutral-200 uppercase tracking-wider">Quick Info</h3>
          <ul class="text-sm text-neutral-400 space-y-2">
            <li><strong class="text-neutral-300 font-medium">Location:</strong> Worldwide / Remote</li>
            <li><strong class="text-neutral-300 font-medium">Focus:</strong> Full-Stack & Systems</li>
            <li><strong class="text-neutral-300 font-medium">Interests:</strong> Web Dev, AI/RL, Design</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="space-y-6 scroll-mt-20">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2 text-sky-400 font-mono text-sm">
          <FolderGit2 class="w-4 h-4" />
          <span>Featured Projects</span>
        </div>
        <a 
          href="https://github.com/amaydle" 
          target="_blank" 
          rel="noreferrer" 
          class="text-xs text-neutral-400 hover:text-sky-400 inline-flex items-center gap-1 transition-colors"
        >
          See more on GitHub <ArrowUpRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projects.map((project) => (
          <div class="group flex flex-col justify-between p-6 rounded-xl bg-neutral-900/50 border border-neutral-800/80 hover:border-neutral-700 hover:bg-neutral-900/80 transition-all duration-200">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="font-semibold text-lg text-neutral-100 group-hover:text-sky-400 transition-colors">
                  {project.title}
                </h3>
                <div class="flex items-center gap-2 text-neutral-400">
                  {project.github && (
                    <a href={project.github} target="_blank" rel="noreferrer" class="p-1 hover:text-white transition-colors" aria-label={`GitHub repo for ${project.title}`}>
                      <Github class="w-4 h-4" />
                    </a>
                  )}
                  {project.demo && (
                    <a href={project.demo} target="_blank" rel="noreferrer" class="p-1 hover:text-white transition-colors" aria-label={`Live demo for ${project.title}`}>
                      <ExternalLink class="w-4 h-4" />
                    </a>
                  )}
                </div>
              </div>
              <p class="text-neutral-400 text-sm leading-relaxed">
                {project.description}
              </p>
            </div>

            <div class="flex flex-wrap gap-2 pt-4 mt-2">
              {project.tags.map((tag) => (
                <span class="px-2.5 py-0.5 text-xs rounded-md bg-neutral-800/70 text-neutral-300 font-mono border border-neutral-700/50">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="space-y-6 scroll-mt-20">
      <div class="flex items-center gap-2 text-sky-400 font-mono text-sm">
        <Code2 class="w-4 h-4" />
        <span>Skills & Technologies</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        {skillCategories.map((group) => (
          <div class="p-5 rounded-xl bg-neutral-900/40 border border-neutral-800/80 space-y-3">
            <h3 class="text-sm font-semibold text-neutral-200 font-mono tracking-wide">
              {group.category}
            </h3>
            <ul class="space-y-2 text-sm text-neutral-400">
              {group.skills.map((skill) => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="space-y-6 scroll-mt-20">
      <div class="p-8 sm:p-12 rounded-2xl bg-gradient-to-b from-neutral-900 to-neutral-950 border border-neutral-800 text-center space-y-6">
        <div class="max-w-xl mx-auto space-y-3">
          <h2 class="text-2xl sm:text-3xl font-bold text-neutral-100">
            Let's build something together
          </h2>
          <p class="text-neutral-400 text-sm sm:text-base leading-relaxed">
            Whether you have an inquiry, an interesting project, or just want to say hi, my inbox is always open.
          </p>
        </div>

        <div class="flex flex-wrap justify-center gap-4">
          <a 
            href="mailto:amayauthsarani@gmail.com" 
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-sky-500 hover:bg-sky-400 text-neutral-950 font-semibold text-sm transition-all shadow-lg shadow-sky-500/20"
          >
            <Mail class="w-4 h-4" />
            amayauthsarani@gmail.com
          </a>
          <a 
            href="https://www.linkedin.com/in/amaydle/" 
            target="_blank" 
            rel="noreferrer" 
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-neutral-900 hover:bg-neutral-800 text-neutral-200 border border-neutral-800 font-medium text-sm transition-colors"
          >
            <Linkedin class="w-4 h-4" />
            Connect on LinkedIn
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-neutral-800/80 py-8 text-center text-xs text-neutral-500">
    <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>© {new Date().getFullYear()} Amaya Kahada Gamage. All rights reserved.</p>
      <p class="flex items-center gap-2">
        Built with <a href="https://astro.build" target="_blank" rel="noreferrer" class="text-neutral-400 hover:text-white transition-colors">Astro</a> & 
        <a href="https://tailwindcss.com" target="_blank" rel="noreferrer" class="text-neutral-400 hover:text-white transition-colors">Tailwind CSS</a>
      </p>
    </div>
  </footer>
</Layout>
