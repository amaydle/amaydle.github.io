---
import Layout from '../layouts/Layout.astro';
import { 
  Github, 
  Linkedin, 
  Mail, 
  ArrowUpRight
} from 'lucide-astro';

const projects = [
  {
    title: "FilmStrip",
    description: "An aesthetic filter and photo curation application designed to give digital photos the vintage warmth of analog film.",
    tags: ["React", "TypeScript", "Tailwind CSS", "Canvas API"],
    github: "https://github.com/amaydle/FilmStrip",
    demo: null,
  },
  {
    title: "CodeRL",
    description: "Final Year Project / Dissertation research exploring reinforcement learning paradigms applied to automated code reasoning and synthesis.",
    tags: ["Python", "PyTorch", "Reinforcement Learning", "NLP"],
    github: "https://github.com/amaydle/CodeRL",
    demo: null,
  },
  {
    title: "Getting Things Done (GTD)",
    description: "A streamlined productivity app implementing David Allen's Getting Things Done framework for mindful task capture and intuitive workflows.",
    tags: ["TypeScript", "Full Stack", "Productivity"],
    github: "https://github.com/amaydle/getting-things-done",
    demo: null,
  },
  {
    title: "Cumulus",
    description: "A lightweight cloud utility and microservice designed for seamless data synchronization and storage experiments.",
    tags: ["Cloud", "API", "Backend"],
    github: "https://github.com/amaydle/Cumulus",
    demo: null,
  },
  {
    title: "Experiments & Snippets",
    description: "A curated repository of small-scale implementations, creative algorithms, playful UI components, and code experiments.",
    tags: ["Algorithms", "Web Dev", "Prototyping"],
    github: "https://github.com/amaydle/experiments",
    demo: null,
  }
];

const skillCategories = [
  {
    category: "Languages",
    skills: ["TypeScript", "JavaScript", "Python", "HTML5 / CSS3", "SQL"]
  },
  {
    category: "Frontend & UI",
    skills: ["React", "Astro", "Tailwind CSS", "Next.js", "Responsive Design"]
  },
  {
    category: "Backend & Systems",
    skills: ["Node.js", "Express", "RESTful APIs", "Git / GitHub", "Docker"]
  },
  {
    category: "Interests & Research",
    skills: ["Machine Learning", "Reinforcement Learning", "UI/UX Design", "Creative Coding"]
  }
];
---

<Layout title="Amaya | Portfolio">
  <main class="max-w-4xl mx-auto px-6 space-y-24 pt-12 sm:pt-20 pb-20 sm:pb-28">
    <!-- Fullscreen Hero Section (Seamless, Unboxed) -->
    <section class="min-h-[calc(100vh-8rem)] flex flex-col justify-between pb-12">
      <div class="my-auto grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 items-center">
        
        <!-- Left Side: Doodle Illustration with Gentle Breeze Animation -->
        <div class="md:col-span-5 flex justify-center order-2 md:order-1">
          <div class="relative flex flex-col items-center justify-center py-4">
            <canvas 
              id="doodle-canvas" 
              class="w-64 sm:w-80 h-auto object-contain select-none cursor-pointer"
              title="A gentle breeze..."
              aria-label="Doodle of Amaya with her scarf swaying in a gentle breeze"
            ></canvas>
            <noscript>
              <img 
                src="/doodle.png" 
                alt="Doodle of Amaya with scarf" 
                class="w-64 sm:w-80 h-auto object-contain select-none"
              />
            </noscript>
          </div>
        </div>

        <!-- Right Side: Intro & I like xyz (Seamless Flow) -->
        <div class="md:col-span-7 space-y-6 order-1 md:order-2">
          <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-[#141414]">
            Hello <span class="text-[#7EA5C4] font-normal">✦</span> Amaya here!
          </h1>

          <!-- Things I Like (Seamless List) -->
          <div class="space-y-2 pt-1">
            <p class="text-xs font-semibold uppercase tracking-wider text-[#666666]">
              things I like
            </p>
            <ul class="space-y-2 text-[15px] text-[#141414]">
              <li class="flex items-start gap-2.5">
                <span class="text-[#7EA5C4] select-none">•</span>
                <span>crafting thoughtful web applications & playful interfaces</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-[#E29BA8] select-none">•</span>
                <span>doodling, analog film photography, & design experiments</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-[#7EA5C4] select-none">•</span>
                <span>exploring machine learning, algorithms, & cozy coffee shops</span>
              </li>
            </ul>
          </div>

          <p class="text-[15px] text-[#666666] leading-relaxed max-w-lg">
            Software engineer and developer creating thoughtful code, exploring intelligent systems, and designing warm, intuitive experiences.
          </p>

          <!-- Call to Actions & Social Links -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a 
              href="#projects" 
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-[#141414] hover:bg-[#2c2c2c] text-white font-medium text-sm transition-colors"
            >
              view projects
              <ArrowUpRight class="w-4 h-4" />
            </a>
            <a 
              href="mailto:amayauthsarani@gmail.com" 
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-transparent hover:bg-neutral-200/50 text-[#141414] border border-[#d8d3c8] font-medium text-sm transition-colors"
            >
              <Mail class="w-4 h-4" />
              get in touch
            </a>

            <div class="flex items-center space-x-1 pl-2 text-[#666666] border-l border-[#d8d3c8]">
              <a 
                href="https://github.com/amaydle" 
                target="_blank" 
                rel="noreferrer" 
                class="p-2 hover:text-[#7EA5C4] transition-colors" 
                aria-label="GitHub"
              >
                <Github class="w-5 h-5" />
              </a>
              <a 
                href="https://www.linkedin.com/in/amaydle/" 
                target="_blank" 
                rel="noreferrer" 
                class="p-2 hover:text-[#7EA5C4] transition-colors" 
                aria-label="LinkedIn"
              >
                <Linkedin class="w-5 h-5" />
              </a>
            </div>
          </div>
        </div>

      </div>

      <!-- Scroll down indicator -->
      <div class="pt-6 pb-2 text-center text-xs text-[#666666] flex flex-col items-center gap-1 opacity-70 hover:opacity-100 transition-opacity">
        <span>scroll down</span>
        <span class="animate-bounce text-[#7EA5C4] text-sm">↓</span>
      </div>
    </section>

    <!-- About Section (Seamless) -->
    <section id="about" class="space-y-6 scroll-mt-16">
      <div class="flex items-center gap-3 border-b border-[#E5E0D5] pb-3">
        <span class="text-xs font-semibold tracking-wider text-[#666666]">01</span>
        <h2 class="text-lg font-bold text-[#141414]">About Me</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pt-2">
        <div class="md:col-span-8 space-y-4 text-[#141414] leading-relaxed text-[15px]">
          <p>
            I'm a developer who enjoys solving complex problems and turning ideas into clean, functional, and visually inviting software. My interests bridge full-stack engineering, creative user interfaces, and machine learning research.
          </p>
          <p>
            When building, I look for elegance in both architecture and interaction: clean code under the hood, and a warm, delightful feel on the surface.
          </p>
        </div>

        <div class="md:col-span-4 space-y-3 text-sm text-[#666666] md:border-l md:border-[#E5E0D5] md:pl-6">
          <p class="font-semibold text-xs uppercase tracking-wider text-[#666666]">Quick Notes</p>
          <ul class="space-y-2 text-[14px]">
            <li><span class="text-[#888888] block text-xs">location</span>Remote / Worldwide</li>
            <li><span class="text-[#888888] block text-xs">focus</span>Full-Stack & Systems</li>
            <li><span class="text-[#888888] block text-xs">interests</span>Web, AI/RL, Art & UI</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Projects Section (Seamless Editorial List) -->
    <section id="projects" class="space-y-6 scroll-mt-16">
      <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-3">
        <div class="flex items-center gap-3">
          <span class="text-xs font-semibold tracking-wider text-[#666666]">02</span>
          <h2 class="text-lg font-bold text-[#141414]">Featured Projects</h2>
        </div>
        <a 
          href="https://github.com/amaydle" 
          target="_blank" 
          rel="noreferrer" 
          class="text-xs font-medium text-[#666666] hover:text-[#7EA5C4] inline-flex items-center gap-1 transition-colors"
        >
          github.com/amaydle <ArrowUpRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="divide-y divide-[#E5E0D5] pt-2">
        {projects.map((project) => (
          <div class="py-6 first:pt-2 last:pb-2 space-y-2 group">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-semibold text-base text-[#141414] group-hover:text-[#7EA5C4] transition-colors">
                {project.title}
              </h3>
              <div class="flex items-center gap-3 text-[#666666] text-xs shrink-0">
                {project.github && (
                  <a 
                    href={project.github} 
                    target="_blank" 
                    rel="noreferrer" 
                    class="hover:text-[#7EA5C4] transition-colors inline-flex items-center gap-1"
                  >
                    code <ArrowUpRight class="w-3 h-3" />
                  </a>
                )}
                {project.demo && (
                  <a 
                    href={project.demo} 
                    target="_blank" 
                    rel="noreferrer" 
                    class="hover:text-[#7EA5C4] transition-colors inline-flex items-center gap-1"
                  >
                    live <ArrowUpRight class="w-3 h-3" />
                  </a>
                )}
              </div>
            </div>
            
            <p class="text-[#666666] text-sm leading-relaxed max-w-2xl">
              {project.description}
            </p>

            <div class="flex flex-wrap gap-2 pt-1">
              {project.tags.map((tag) => (
                <span class="text-xs text-[#888888] font-medium">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills Section (Seamless) -->
    <section id="skills" class="space-y-6 scroll-mt-16">
      <div class="flex items-center gap-3 border-b border-[#E5E0D5] pb-3">
        <span class="text-xs font-semibold tracking-wider text-[#666666]">03</span>
        <h2 class="text-lg font-bold text-[#141414]">Skills & Toolbox</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 pt-2">
        {skillCategories.map((group) => (
          <div class="space-y-3">
            <h3 class="font-semibold text-sm text-[#141414]">
              {group.category}
            </h3>
            <ul class="space-y-2 text-sm text-[#666666]">
              {group.skills.map((skill) => (
                <li class="flex items-center gap-2">
                  <span class="text-[#7EA5C4]">•</span>
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact Section (Seamless) -->
    <section id="contact" class="space-y-6 scroll-mt-16 pt-8">
      <div class="text-center space-y-4 max-w-md mx-auto">
        <div class="text-xs font-semibold uppercase tracking-wider text-[#666666]">
          04 / Get In Touch
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#141414]">
          Say hello („• ֊ •„)੭
        </h2>
        <p class="text-[#666666] text-sm leading-relaxed">
          Have a question, a project idea, or just want to chat about tech or art? My inbox is always open.
        </p>

        <div class="flex flex-wrap justify-center gap-3 pt-3">
          <a 
            href="mailto:amayauthsarani@gmail.com" 
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-md bg-[#141414] hover:bg-[#2c2c2c] text-white font-medium text-sm transition-colors"
          >
            <Mail class="w-4 h-4" />
            amayauthsarani@gmail.com
          </a>
          <a 
            href="https://www.linkedin.com/in/amaydle/" 
            target="_blank" 
            rel="noreferrer" 
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-md bg-transparent hover:bg-neutral-200/50 text-[#141414] border border-[#d8d3c8] font-medium text-sm transition-colors"
          >
            <Linkedin class="w-4 h-4" />
            LinkedIn
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  function initDoodleBreeze() {
    const canvas = document.getElementById('doodle-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const img = new Image();
    img.src = '/doodle.png';

    let isVisible = true;

    // Pause when scrolled out of view to preserve battery/CPU
    const observer = new IntersectionObserver((entries) => {
      isVisible = entries[0]?.isIntersecting ?? true;
    }, { threshold: 0.1 });
    observer.observe(canvas);

    img.onload = () => {
      const dpr = window.devicePixelRatio || 1;
      canvas.width = img.width * dpr;
      canvas.height = img.height * dpr;
      canvas.style.aspectRatio = `${img.width} / ${img.height}`;
      ctx.scale(dpr, dpr);

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) {
        ctx.drawImage(img, 0, 0);
        return;
      }

      function render(time: number) {
        if (isVisible) {
          ctx.clearRect(0, 0, img.width, img.height);

          const sliceWidth = 2;
          const splitY = 113; // transparent gap between hair (y<=109) and scarf (y>=118)
          const anchorScarfX = 180; // scarf connects smoothly at neck collar without cutting body
          const anchorHairX = 175;  // hair lock tapers seamlessly into the back of head

          // A slow, peaceful, natural breeze speed (no frantic rush)
          const speed = 0.0011;

          for (let x = 0; x < img.width; x += sliceWidth) {
            const w = Math.min(sliceWidth, img.width - x);

            if (x >= 180) {
              // Face, star clip, and body are rendered completely solid and uncut (no horizontal seams)
              ctx.drawImage(img, x, 0, w, img.height, x, 0, w, img.height);
            } else {
              // 1. Hair lock motion (upper zone in transparent gap: delicate flutter at back of head)
              let hairDy = 0;
              if (x >= 140 && x < anchorHairX) {
                const hairFactor = Math.pow((anchorHairX - x) / (anchorHairX - 140), 1.3);
                hairDy = (Math.sin(time * (speed * 1.35) + x * 0.055) + Math.cos(time * (speed * 0.9) + x * 0.04) * 0.25) * 1.5 * hairFactor;
              }
              ctx.drawImage(img, x, 0, w, splitY, x, hairDy, w, splitY);

              // 2. Scarf wave (lower zone in transparent gap: graceful undulating sway)
              const scarfFactor = Math.pow((anchorScarfX - x) / anchorScarfX, 1.35);
              const wave1 = Math.sin(time * speed + x * 0.032);
              const wave2 = Math.cos(time * (speed * 1.4) + x * 0.05) * 0.25;
              const scarfDy = (wave1 + wave2) * scarfFactor * 3.8;
              ctx.drawImage(img, x, splitY, w, img.height - splitY, x, splitY + scarfDy, w, img.height - splitY);
            }
          }
        }

        requestAnimationFrame(render);
      }

      requestAnimationFrame(render);
    };
  }

  initDoodleBreeze();
  document.addEventListener('astro:page-load', initDoodleBreeze);
</script>
