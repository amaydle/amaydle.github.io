---
import Layout from '../layouts/Layout.astro';
import { 
  Github, 
  Linkedin, 
  Mail, 
  ExternalLink, 
  ArrowUpRight,
  Sparkles,
  Heart,
  FileText,
  Trees
} from 'lucide-astro';

const projects = [
  {
    title: "FilmStrip",
    description: "An aesthetic filter and photo curation application designed to give digital photos the vintage warmth of analog film.",
    tags: ["React", "TypeScript", "Tailwind CSS", "Canvas API"],
    github: "https://github.com/amaydle/FilmStrip",
    demo: null,
  },
  {
    title: "CodeRL",
    description: "Final Year Project / Dissertation research exploring reinforcement learning paradigms applied to automated code reasoning and synthesis.",
    tags: ["Python", "PyTorch", "Reinforcement Learning", "NLP"],
    github: "https://github.com/amaydle/CodeRL",
    demo: null,
  },
  {
    title: "Getting Things Done (GTD)",
    description: "A streamlined productivity app implementing David Allen's Getting Things Done framework for mindful task capture and intuitive workflows.",
    tags: ["TypeScript", "Full Stack", "Productivity"],
    github: "https://github.com/amaydle/getting-things-done",
    demo: null,
  },
  {
    title: "Cumulus",
    description: "A lightweight cloud utility and microservice designed for seamless data synchronization and storage experiments.",
    tags: ["Cloud", "API", "Backend"],
    github: "https://github.com/amaydle/Cumulus",
    demo: null,
  },
  {
    title: "Experiments & Snippets",
    description: "A curated repository of small-scale implementations, creative algorithms, playful UI components, and code experiments.",
    tags: ["Algorithms", "Web Dev", "Prototyping"],
    github: "https://github.com/amaydle/experiments",
    demo: null,
  }
];

const skillCategories = [
  {
    category: "Languages",
    skills: ["TypeScript", "JavaScript", "Python", "HTML5 / CSS3", "SQL"]
  },
  {
    category: "Frontend & UI",
    skills: ["React", "Astro", "Tailwind CSS", "Next.js", "Responsive Design", "Figma"]
  },
  {
    category: "Backend & Systems",
    skills: ["Node.js", "Express", "RESTful APIs", "Git / GitHub", "Docker"]
  },
  {
    category: "Interests & Research",
    skills: ["Machine Learning", "Reinforcement Learning", "UI/UX Design", "Creative Coding"]
  }
];
---

<Layout title="Amaya | Portfolio">
  <main class="max-w-5xl mx-auto px-6 space-y-28 pt-8 sm:pt-16">
    <!-- Fullscreen Hero Section -->
    <section class="min-h-[calc(100vh-6rem)] flex flex-col justify-between pb-8">
      <div class="my-auto grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-center">
        
        <!-- Left Side: Doodle Illustration Space (Under a tree) -->
        <div class="md:col-span-6 flex justify-center order-2 md:order-1">
          <div class="relative w-full max-w-sm sm:max-w-md aspect-square rounded-2xl bg-white border-2 border-dashed border-neutral-300 p-8 flex flex-col items-center justify-center text-center shadow-xs overflow-hidden group">
            
            <!-- Illustration placeholder -->
            <div class="relative z-10 flex flex-col items-center space-y-4">
              <div class="w-18 h-18 rounded-2xl bg-[#F9F7F2] border border-neutral-200 flex items-center justify-center text-neutral-700 shadow-xs group-hover:scale-105 transition-transform duration-300">
                <Trees class="w-9 h-9 text-neutral-800" />
              </div>
              
              <div class="space-y-1.5 max-w-xs">
                <p class="font-semibold text-base text-neutral-900 tracking-tight">
                  doodle illustration space
                </p>
                <p class="text-xs text-neutral-500 leading-relaxed">
                  me under a tree with my scarf & sweater :)
                </p>
              </div>

              <div class="pt-1">
                <span class="inline-flex items-center px-3 py-1 rounded-md text-xs font-medium bg-[#F9F7F2] text-neutral-600 border border-neutral-200">
                  ready for illustration
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side: Intro & I like xyz -->
        <div class="md:col-span-6 space-y-6 order-1 md:order-2">
          <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-neutral-950 leading-[1.1]">
            Hi, I'm <span>Amaya</span>
          </h1>

          <!-- "I like xyz" Card -->
          <div class="p-6 rounded-xl bg-white border border-neutral-200/90 shadow-xs space-y-3.5">
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-neutral-500 pb-2 border-b border-neutral-100">
              <Sparkles class="w-3.5 h-3.5 text-neutral-700" />
              <span>things I like</span>
            </div>
            <ul class="space-y-2.5 text-sm text-neutral-600">
              <li class="flex items-start gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-neutral-900 shrink-0 mt-2"></span>
                <span class="text-neutral-900 leading-relaxed">crafting thoughtful web applications & playful interfaces</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-neutral-900 shrink-0 mt-2"></span>
                <span class="text-neutral-900 leading-relaxed">doodling, analog film photography, & design experiments</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-neutral-900 shrink-0 mt-2"></span>
                <span class="text-neutral-900 leading-relaxed">exploring machine learning, algorithms, & cozy coffee shops</span>
              </li>
            </ul>
          </div>

          <p class="text-sm text-neutral-600 leading-relaxed">
            Software engineer and developer creating thoughtful code, exploring intelligent systems, and designing warm, intuitive experiences.
          </p>

          <!-- Call to Actions & Social Links -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a 
              href="#projects" 
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-neutral-950 hover:bg-neutral-800 text-white font-medium text-sm transition-colors shadow-xs"
            >
              view projects
              <ArrowUpRight class="w-4 h-4" />
            </a>
            <a 
              href="mailto:amayauthsarani@gmail.com" 
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-white hover:bg-neutral-50 text-neutral-900 border border-neutral-300 font-medium text-sm transition-colors shadow-xs"
            >
              <Mail class="w-4 h-4" />
              get in touch
            </a>

            <div class="flex items-center space-x-1 pl-2 text-neutral-500 border-l border-neutral-300">
              <a 
                href="https://github.com/amaydle" 
                target="_blank" 
                rel="noreferrer" 
                class="p-2 hover:text-black transition-colors" 
                aria-label="GitHub"
              >
                <Github class="w-5 h-5" />
              </a>
              <a 
                href="https://www.linkedin.com/in/amaydle/" 
                target="_blank" 
                rel="noreferrer" 
                class="p-2 hover:text-black transition-colors" 
                aria-label="LinkedIn"
              >
                <Linkedin class="w-5 h-5" />
              </a>
            </div>
          </div>
        </div>

      </div>

      <!-- Scroll down indicator -->
      <div class="pt-4 pb-2 text-center text-xs text-neutral-400 flex flex-col items-center gap-1.5 opacity-70 hover:opacity-100 transition-opacity">
        <span>scroll down</span>
        <span class="animate-bounce text-neutral-600 text-sm">↓</span>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="space-y-7 scroll-mt-12">
      <div class="flex items-center gap-3">
        <span class="text-xs font-semibold tracking-wider text-neutral-400">01</span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-950">About Me</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4 text-neutral-900 leading-relaxed text-sm sm:text-base">
          <p class="p-7 rounded-xl bg-white border border-neutral-200/90 shadow-xs">
            I'm a developer who enjoys solving complex problems and turning ideas into clean, functional, and visually inviting software. My interests bridge full-stack engineering, creative user interfaces, and machine learning research.
          </p>
          <p class="p-7 rounded-xl bg-white border border-neutral-200/90 shadow-xs">
            When building, I look for elegance in both architecture and interaction: clean code under the hood, and a warm, delightful feel on the surface.
          </p>
        </div>

        <!-- Quick Info Note Card -->
        <div class="p-7 rounded-xl bg-white border border-neutral-200/90 shadow-xs space-y-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-neutral-500 pb-3 border-b border-neutral-100">
              <FileText class="w-4 h-4 text-neutral-700" />
              Quick Notes
            </div>
            <ul class="text-xs sm:text-sm text-neutral-900 space-y-3.5 pt-4">
              <li>
                <span class="text-neutral-500 block text-xs">location</span>
                <span class="font-medium">Remote / Worldwide</span>
              </li>
              <li>
                <span class="text-neutral-500 block text-xs">focus</span>
                <span class="font-medium">Full-Stack & Systems</span>
              </li>
              <li>
                <span class="text-neutral-500 block text-xs">interests</span>
                <span class="font-medium">Web, AI/RL, Art & UI</span>
              </li>
            </ul>
          </div>

          <div class="pt-4 border-t border-neutral-100 text-xs text-neutral-500 flex items-center gap-1.5">
            <Heart class="w-3.5 h-3.5 text-neutral-400" />
            <span>art + code</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="space-y-7 scroll-mt-12">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-xs font-semibold tracking-wider text-neutral-400">02</span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-950">Featured Projects</h2>
        </div>
        <a 
          href="https://github.com/amaydle" 
          target="_blank" 
          rel="noreferrer" 
          class="text-xs font-medium text-neutral-500 hover:text-black inline-flex items-center gap-1 transition-colors"
        >
          github.com/amaydle <ArrowUpRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projects.map((project) => (
          <div class="group flex flex-col justify-between p-7 rounded-xl bg-white border border-neutral-200/90 hover:border-neutral-400 hover:shadow-xs transition-all duration-200">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="font-bold text-lg tracking-tight text-neutral-950 group-hover:text-neutral-700 transition-colors">
                  {project.title}
                </h3>
                <div class="flex items-center gap-2 text-neutral-400">
                  {project.github && (
                    <a 
                      href={project.github} 
                      target="_blank" 
                      rel="noreferrer" 
                      class="p-1.5 hover:text-black transition-colors rounded-md hover:bg-neutral-100" 
                      aria-label={`GitHub repo for ${project.title}`}
                    >
                      <Github class="w-4 h-4" />
                    </a>
                  )}
                  {project.demo && (
                    <a 
                      href={project.demo} 
                      target="_blank" 
                      rel="noreferrer" 
                      class="p-1.5 hover:text-black transition-colors rounded-md hover:bg-neutral-100" 
                      aria-label={`Live demo for ${project.title}`}
                    >
                      <ExternalLink class="w-4 h-4" />
                    </a>
                  )}
                </div>
              </div>
              <p class="text-neutral-600 text-sm leading-relaxed">
                {project.description}
              </p>
            </div>

            <div class="flex flex-wrap gap-2 pt-5 mt-2">
              {project.tags.map((tag) => (
                <span class="px-2.5 py-1 text-xs rounded-md bg-[#F4F1EA] text-neutral-800 border border-neutral-200/80 font-medium">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="space-y-7 scroll-mt-12">
      <div class="flex items-center gap-3">
        <span class="text-xs font-semibold tracking-wider text-neutral-400">03</span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-950">Skills & Toolbox</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        {skillCategories.map((group) => (
          <div class="p-6 rounded-xl bg-white border border-neutral-200/90 space-y-4 shadow-xs">
            <h3 class="font-bold text-sm tracking-tight text-neutral-950 pb-2.5 border-b border-neutral-100">
              {group.category}
            </h3>
            <ul class="space-y-2.5 text-sm text-neutral-600">
              {group.skills.map((skill) => (
                <li class="flex items-center gap-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-neutral-800"></span>
                  <span class="text-neutral-900 font-medium">{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="space-y-7 scroll-mt-12">
      <div class="p-10 sm:p-14 rounded-2xl bg-white border border-neutral-200/90 text-center space-y-6 shadow-xs">
        <div class="max-w-md mx-auto space-y-3">
          <div class="inline-flex items-center gap-1.5 text-xs text-neutral-500 font-semibold uppercase tracking-wider">
            <Sparkles class="w-3.5 h-3.5 text-neutral-700" />
            <span>04 / Get In Touch</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-950">
            Say hello :)
          </h2>
          <p class="text-neutral-600 text-sm leading-relaxed">
            Have a question, a project idea, or just want to chat about tech or art? My inbox is always open.
          </p>
        </div>

        <div class="flex flex-wrap justify-center gap-3 pt-2">
          <a 
            href="mailto:amayauthsarani@gmail.com" 
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-neutral-950 hover:bg-neutral-800 text-white font-medium text-sm transition-colors shadow-xs"
          >
            <Mail class="w-4 h-4" />
            amayauthsarani@gmail.com
          </a>
          <a 
            href="https://www.linkedin.com/in/amaydle/" 
            target="_blank" 
            rel="noreferrer" 
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-white hover:bg-neutral-50 text-neutral-900 border border-neutral-300 font-medium text-sm transition-colors shadow-xs"
          >
            <Linkedin class="w-4 h-4" />
            LinkedIn
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-neutral-200/80 py-10 text-center text-xs text-neutral-500">
    <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>© {new Date().getFullYear()} Amaya. All rights reserved.</p>
      <p class="flex items-center gap-1.5">
        crafted with care using Astro & Tailwind
      </p>
    </div>
  </footer>
</Layout>
