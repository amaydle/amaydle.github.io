---
import Layout from '../layouts/Layout.astro';
import { 
  Github, 
  Linkedin, 
  Mail, 
  ExternalLink, 
  FolderGit2, 
  Code2, 
  ArrowUpRight,
  Sparkles,
  Heart,
  FileText,
  Trees
} from 'lucide-astro';

const projects = [
  {
    title: "FilmStrip",
    description: "An aesthetic filter and photo curation application designed to give digital photos the vintage warmth of analog film.",
    tags: ["React", "TypeScript", "Tailwind CSS", "Canvas API"],
    github: "https://github.com/amaydle/FilmStrip",
    demo: null,
  },
  {
    title: "CodeRL",
    description: "Final Year Project / Dissertation research exploring reinforcement learning paradigms applied to automated code reasoning and synthesis.",
    tags: ["Python", "PyTorch", "Reinforcement Learning", "NLP"],
    github: "https://github.com/amaydle/CodeRL",
    demo: null,
  },
  {
    title: "Getting Things Done (GTD)",
    description: "A streamlined productivity app implementing David Allen's Getting Things Done framework for mindful task capture and intuitive workflows.",
    tags: ["TypeScript", "Full Stack", "Productivity"],
    github: "https://github.com/amaydle/getting-things-done",
    demo: null,
  },
  {
    title: "Cumulus",
    description: "A lightweight cloud utility and microservice designed for seamless data synchronization and storage experiments.",
    tags: ["Cloud", "API", "Backend"],
    github: "https://github.com/amaydle/Cumulus",
    demo: null,
  },
  {
    title: "Experiments & Snippets",
    description: "A curated repository of small-scale implementations, creative algorithms, playful UI components, and code experiments.",
    tags: ["Algorithms", "Web Dev", "Prototyping"],
    github: "https://github.com/amaydle/experiments",
    demo: null,
  }
];

const skillCategories = [
  {
    category: "Languages",
    skills: ["TypeScript", "JavaScript", "Python", "HTML5 / CSS3", "SQL"]
  },
  {
    category: "Frontend & UI",
    skills: ["React", "Astro", "Tailwind CSS", "Next.js", "Responsive Design", "Figma"]
  },
  {
    category: "Backend & Systems",
    skills: ["Node.js", "Express", "RESTful APIs", "Git / GitHub", "Docker"]
  },
  {
    category: "Interests & Research",
    skills: ["Machine Learning", "Reinforcement Learning", "UI/UX Design", "Creative Coding"]
  }
];
---

<Layout title="Amaya | Portfolio">
  <!-- Top Navigation Bar -->
  <header class="sticky top-0 z-50 backdrop-blur-md bg-[#FCF7E6]/90 border-b border-[#E8D9C5]">
    <div class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="#" class="font-bold text-lg tracking-tight text-[#483427] hover:text-[#88BAE0] transition-colors">
        amaydle<span class="text-[#F2C2CC]">.</span>
      </a>

      <nav class="hidden sm:flex items-center space-x-6 text-sm font-medium text-[#7E695A]">
        <a href="#about" class="hover:text-[#483427] transition-colors">about</a>
        <a href="#projects" class="hover:text-[#483427] transition-colors">projects</a>
        <a href="#skills" class="hover:text-[#483427] transition-colors">skills</a>
        <a href="#contact" class="hover:text-[#483427] transition-colors">contact</a>
      </nav>

      <div class="flex items-center space-x-3 text-[#7E695A]">
        <a 
          href="https://github.com/amaydle" 
          target="_blank" 
          rel="noreferrer" 
          class="p-2 hover:text-[#483427] transition-colors" 
          aria-label="GitHub"
        >
          <Github class="w-5 h-5" />
        </a>
        <a 
          href="https://www.linkedin.com/in/amaydle/" 
          target="_blank" 
          rel="noreferrer" 
          class="p-2 hover:text-[#483427] transition-colors" 
          aria-label="LinkedIn"
        >
          <Linkedin class="w-5 h-5" />
        </a>
        <a 
          href="mailto:amayauthsarani@gmail.com" 
          class="p-2 hover:text-[#483427] transition-colors" 
          aria-label="Email"
        >
          <Mail class="w-5 h-5" />
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-6 space-y-24">
    <!-- Fullscreen Hero Section -->
    <section class="min-h-[calc(100vh-4rem)] flex flex-col justify-between pt-4 pb-8">
      <div class="my-auto grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-center">
        
        <!-- Left Side: Doodle Illustration Space (Under a tree) -->
        <div class="md:col-span-6 flex justify-center order-2 md:order-1">
          <div class="relative w-full max-w-sm sm:max-w-md aspect-square rounded-2xl bg-[#FFFDF8] border-2 border-dashed border-[#DCCABA] p-6 flex flex-col items-center justify-center text-center shadow-sm overflow-hidden group">
            
            <!-- Subtle decorative background accents -->
            <div class="absolute -top-6 -right-6 w-32 h-32 rounded-full bg-[#FCF7E6] opacity-60 pointer-events-none"></div>
            <div class="absolute -bottom-10 -left-10 w-36 h-36 rounded-full bg-[#FCEBF0] opacity-40 pointer-events-none"></div>

            <!-- Illustration placeholder / Drop-in target -->
            <div class="relative z-10 flex flex-col items-center space-y-4">
              <div class="w-16 h-16 rounded-2xl bg-[#FCF7E6] border border-[#E8D9C5] flex items-center justify-center text-[#88BAE0] shadow-sm group-hover:scale-105 transition-transform">
                <Trees class="w-8 h-8 text-[#88BAE0]" />
              </div>
              
              <div class="space-y-1.5 max-w-xs">
                <p class="font-bold text-sm text-[#483427] tracking-tight">
                  // doodle: me under a tree
                </p>
                <p class="text-xs text-[#7E695A] leading-relaxed">
                  sitting under a tree with my scarf & sweater :)
                </p>
              </div>

              <div class="pt-1">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-[11px] font-mono bg-[#FCF7E6] text-[#7E695A] border border-[#E8D9C5]">
                  <span>ready for illustration</span>
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side: Intro & I like xyz -->
        <div class="md:col-span-6 space-y-6 order-1 md:order-2">
          <div class="space-y-2">
            <span class="text-xs font-bold text-[#88BAE0] tracking-wider uppercase">
              // welcome to my space
            </span>
            <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#483427] leading-tight">
              Hi, I'm <span class="underline decoration-[#88BAE0] decoration-wavy decoration-2 underline-offset-8">Amaya</span>
            </h1>
          </div>

          <!-- "I like xyz" Card -->
          <div class="p-5 rounded-lg bg-[#FFFDF8] border border-[#E8D9C5] shadow-sm space-y-3">
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#7E695A] pb-2 border-b border-[#E8D9C5]">
              <Sparkles class="w-3.5 h-3.5 text-[#88BAE0]" />
              <span>things I like:</span>
            </div>
            <ul class="space-y-2 text-xs sm:text-sm text-[#7E695A]">
              <li class="flex items-start gap-2.5">
                <span class="text-[#88BAE0] font-bold">&gt;</span>
                <span class="text-[#483427]">building thoughtful software & creative user interfaces</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-[#F2C2CC] font-bold">&gt;</span>
                <span class="text-[#483427]">doodling, analog film aesthetics, & design experiments</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-[#88BAE0] font-bold">&gt;</span>
                <span class="text-[#483427]">exploring machine learning, algorithms, & quiet coffee shops</span>
              </li>
            </ul>
          </div>

          <p class="text-xs sm:text-sm text-[#7E695A] leading-relaxed">
            Software engineer and developer creating thoughtful code, exploring intelligent systems, and designing warm, intuitive experiences.
          </p>

          <!-- Call to Actions -->
          <div class="flex flex-wrap gap-3 pt-1">
            <a 
              href="#projects" 
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-[#88BAE0] hover:bg-[#72A9D6] text-[#483427] font-bold text-sm transition-all shadow-sm"
            >
              view projects
              <ArrowUpRight class="w-4 h-4" />
            </a>
            <a 
              href="mailto:amayauthsarani@gmail.com" 
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-[#FFFDF8] hover:bg-[#FDF6E4] text-[#483427] border border-[#E4D5C1] font-medium text-sm transition-colors shadow-sm"
            >
              <Mail class="w-4 h-4 text-[#88BAE0]" />
              get in touch
            </a>
          </div>
        </div>

      </div>

      <!-- Scroll down indicator -->
      <div class="pt-4 pb-2 text-center text-xs text-[#7E695A] flex flex-col items-center gap-1 opacity-70 hover:opacity-100 transition-opacity">
        <span>scroll down</span>
        <span class="animate-bounce text-[#88BAE0] text-sm">↓</span>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="space-y-6 scroll-mt-20">
      <div class="flex items-center gap-2 text-[#483427] text-sm font-bold tracking-wide">
        <span class="text-[#F2C2CC]">//</span>
        <span>01. ABOUT ME</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4 text-[#483427] leading-relaxed text-sm sm:text-base">
          <p class="p-6 rounded-lg bg-[#FFFDF8] border border-[#E8D9C5] shadow-sm">
            I'm a developer who enjoys solving complex problems and turning ideas into clean, functional, and visually inviting software. My interests bridge full-stack engineering, creative user interfaces, and machine learning research.
          </p>
          <p class="p-6 rounded-lg bg-[#FFFDF8] border border-[#E8D9C5] shadow-sm">
            When building, I look for elegance in both architecture and interaction: clean code under the hood, and a warm, delightful feel on the surface.
          </p>
        </div>

        <!-- Quick Info Note Card -->
        <div class="p-6 rounded-lg bg-[#FFFDF8] border border-[#E8D9C5] shadow-sm space-y-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#7E695A] pb-2 border-b border-[#E8D9C5]">
              <FileText class="w-4 h-4 text-[#88BAE0]" />
              Quick Notes
            </div>
            <ul class="text-xs sm:text-sm text-[#483427] space-y-3 pt-3">
              <li>
                <span class="text-[#7E695A]">location:</span> Remote / Worldwide
              </li>
              <li>
                <span class="text-[#7E695A]">focus:</span> Full-Stack & Systems
              </li>
              <li>
                <span class="text-[#7E695A]">interests:</span> Web, AI/RL, Art & UI
              </li>
            </ul>
          </div>

          <div class="pt-4 border-t border-[#E8D9C5] text-xs text-[#7E695A] flex items-center gap-1.5">
            <Heart class="w-3.5 h-3.5 text-[#F2C2CC] fill-[#F2C2CC]" />
            <span>art + code</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="space-y-6 scroll-mt-20">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2 text-[#483427] text-sm font-bold tracking-wide">
          <span class="text-[#88BAE0]">//</span>
          <span>02. FEATURED PROJECTS</span>
        </div>
        <a 
          href="https://github.com/amaydle" 
          target="_blank" 
          rel="noreferrer" 
          class="text-xs text-[#7E695A] hover:text-[#483427] inline-flex items-center gap-1 transition-colors"
        >
          github.com/amaydle <ArrowUpRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projects.map((project) => (
          <div class="group flex flex-col justify-between p-6 rounded-lg bg-[#FFFDF8] border border-[#E8D9C5] hover:border-[#88BAE0] hover:shadow-md transition-all duration-200">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="font-bold text-base sm:text-lg text-[#483427] group-hover:text-[#88BAE0] transition-colors">
                  {project.title}
                </h3>
                <div class="flex items-center gap-2 text-[#7E695A]">
                  {project.github && (
                    <a 
                      href={project.github} 
                      target="_blank" 
                      rel="noreferrer" 
                      class="p-1 hover:text-[#483427] transition-colors" 
                      aria-label={`GitHub repo for ${project.title}`}
                    >
                      <Github class="w-4 h-4" />
                    </a>
                  )}
                  {project.demo && (
                    <a 
                      href={project.demo} 
                      target="_blank" 
                      rel="noreferrer" 
                      class="p-1 hover:text-[#483427] transition-colors" 
                      aria-label={`Live demo for ${project.title}`}
                    >
                      <ExternalLink class="w-4 h-4" />
                    </a>
                  )}
                </div>
              </div>
              <p class="text-[#7E695A] text-xs sm:text-sm leading-relaxed">
                {project.description}
              </p>
            </div>

            <div class="flex flex-wrap gap-2 pt-4 mt-2">
              {project.tags.map((tag) => (
                <span class="px-2.5 py-1 text-xs rounded bg-[#FCF7E6] text-[#483427] border border-[#E8D9C5]">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="space-y-6 scroll-mt-20">
      <div class="flex items-center gap-2 text-[#483427] text-sm font-bold tracking-wide">
        <span class="text-[#F2C2CC]">//</span>
        <span>03. SKILLS & TOOLBOX</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        {skillCategories.map((group) => (
          <div class="p-5 rounded-lg bg-[#FFFDF8] border border-[#E8D9C5] space-y-3 shadow-sm">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[#483427] pb-2 border-b border-[#E8D9C5]">
              {group.category}
            </h3>
            <ul class="space-y-2 text-xs sm:text-sm text-[#7E695A]">
              {group.skills.map((skill) => (
                <li class="flex items-center gap-2">
                  <span class="text-[#88BAE0] font-bold">&gt;</span>
                  <span class="text-[#483427]">{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="space-y-6 scroll-mt-20">
      <div class="p-8 sm:p-12 rounded-lg bg-[#FFFDF8] border border-[#E8D9C5] text-center space-y-6 shadow-sm">
        <div class="max-w-md mx-auto space-y-3">
          <div class="inline-flex items-center gap-1.5 text-xs text-[#F2C2CC] font-bold">
            <Sparkles class="w-3.5 h-3.5 text-[#88BAE0]" />
            <span>// 04. GET IN TOUCH</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-[#483427]">
            Say hello :)
          </h2>
          <p class="text-[#7E695A] text-xs sm:text-sm leading-relaxed">
            Have a question, a project idea, or just want to chat about tech or art? My inbox is always open.
          </p>
        </div>

        <div class="flex flex-wrap justify-center gap-3 pt-2">
          <a 
            href="mailto:amayauthsarani@gmail.com" 
            class="inline-flex items-center gap-2 px-6 py-3 rounded-md bg-[#88BAE0] hover:bg-[#72A9D6] text-[#483427] font-bold text-sm transition-all shadow-sm"
          >
            <Mail class="w-4 h-4" />
            amayauthsarani@gmail.com
          </a>
          <a 
            href="https://www.linkedin.com/in/amaydle/" 
            target="_blank" 
            rel="noreferrer" 
            class="inline-flex items-center gap-2 px-6 py-3 rounded-md bg-[#FCF7E6] hover:bg-[#FDF6E4] text-[#483427] border border-[#E4D5C1] font-medium text-sm transition-colors shadow-sm"
          >
            <Linkedin class="w-4 h-4 text-[#88BAE0]" />
            LinkedIn
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-[#E8D9C5] py-8 text-center text-xs text-[#7E695A]">
    <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>© {new Date().getFullYear()} Amaya</p>
      <p class="flex items-center gap-1.5">
        crafted with <Heart class="w-3 h-3 text-[#F2C2CC] fill-[#F2C2CC]" /> using Astro & Tailwind
      </p>
    </div>
  </footer>
</Layout>
