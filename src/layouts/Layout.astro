---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Amaya | Portfolio",
  description = "Personal portfolio website of Amaya - Software Engineer and Developer."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Google Fonts: Fraunces (Headings) & Plus Jakarta Sans (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..800&family=Plus+Jakarta+Sans:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FCF7E6] text-[#483427] min-h-screen antialiased selection:bg-[#F2C2CC] selection:text-[#483427] font-['Plus_Jakarta_Sans',sans-serif]">
    <slot />
  </body>
</html>
