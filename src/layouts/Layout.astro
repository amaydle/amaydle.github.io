---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Amaya | Portfolio",
  description = "Personal portfolio website of Amaya - Software Engineer and Developer."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-[#F9F7F2] text-[#111111] min-h-screen antialiased selection:bg-neutral-900 selection:text-white">
    <slot />
  </body>
</html>
